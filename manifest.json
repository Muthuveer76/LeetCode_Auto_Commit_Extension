{
  "manifest_version": 3,
  "name": "LeetCode Auto-Committer",
  "version": "1.0",
  "description": "Automatically commits successful LeetCode submissions to GitHub.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Configure GitHub Auth"
  },
  "icons": {
    "128": "icon.png"
  }
}
